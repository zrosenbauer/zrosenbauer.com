{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "exclude": ["unresolved"],
  "entry": [
    "src/app/**/page.tsx",
    "src/app/**/layout.tsx",
    "src/app/**/not-found.tsx",
    "contentlayer.config.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "*.{ts,tsx,mjs,js}"],
  "ignoreDependencies": ["@next/mdx", "@tailwindcss/typography", "tailwindcss", "tw-animate-css"]
}
