{
  "name": "zrosenbauer.com",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "contentlayer2 build && next build",
    "start": "pnpm dlx serve@latest out",
    "preview": "pnpm build && pnpm start",
    "check:types": "contentlayer2 build && tsc --noEmit",
    "typecheck": "pnpm check:types",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "lint:content": "alex 'content/**/*.mdx'",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@next/mdx": "^16.2.6",
    "@tabler/icons-react": "^3.44.0",
    "contentlayer2": "^0.5.8",
    "geist": "^1.7.0",
    "highlight.js": "^11.11.1",
    "lodash": "^4.18.1",
    "next": "^16.2.6",
    "next-contentlayer2": "^0.5.8",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-pretty-code": "^0.14.3",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^2.1.0",
    "shiki": "^4.0.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "alex": "^11.0.1",
    "eslint-plugin-functional": "^9.0.4",
    "eslint-plugin-security": "^4.0.0",
    "knip": "^6.12.2",
    "lefthook": "^2.1.6",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0"
  },
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "contentlayer2",
      "esbuild",
      "lefthook",
      "protobufjs",
      "sharp"
    ]
