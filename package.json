    "knip": "knip",
    "lint:content": "alex 'content/**/*.mdx'",
    "generate:og": "tsx scripts/generate-og.ts",
    "generate:design-banner": "tsx scripts/generate-design-banner.ts",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@next/mdx": "^16.3.8",
    "@tabler/icons-react": "^3.49.0",
    "contentlayer2": "^0.5.8",
    "geist": "^1.7.2",
    "highlight.js": "^11.12.0",
    "lodash": "^4.18.1",
    "next": "^16.3.8",
    "next-contentlayer2": "^0.5.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^2.1.0",
    "shiki": "^4.5.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "alex": "^11.0.1",
    "eslint-plugin-functional": "^10.0.1",
    "eslint-plugin-security": "^4.2.0",
    "knip": "^6.39.0",
    "lefthook": "^2.1.17",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "postcss": "^8.5.29",
    "satori": "^0.35.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "wawoff2": "^2.0.1"
