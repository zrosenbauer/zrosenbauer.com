{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "es5",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "experimentalSortImports": {},
  "ignorePatterns": [
    "node_modules",
    "dist",
    "build",
    "out",
    ".next",
    ".contentlayer",
    ".vercel",
    "coverage",
    "**/.generated/**",
    "**/*.gen.ts",
    "**/*.gen.tsx",
    "**/*.d.ts",
    "public"
  ]
}
